# Copy to .env.local (never commit .env.local).
# VITE_ variables are built into public JavaScript — never put secrets here.

# Google OAuth client ID (not a secret). See Deployment doc > Google Sign-In.
VITE_GOOGLE_CLIENT_ID=

# Where Vite forwards /api in development. Include the context path if Tomcat uses one.
VITE_BACKEND_URL=http://localhost:8080

# Local development only: send X-Dev-User-Id so you can work before login is built.
# Requires COMPASS_DEV_AUTH=true on the backend. Set to a user id from database/seed.sql (e.g. 2 = team lead).
VITE_DEV_USER_ID=
