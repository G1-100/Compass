# Team values for frontend/.env.local. Committed to git: VITE_ values are public anyway (built into the JS bundle).

# Google OAuth web client ID (not a secret).
VITE_GOOGLE_CLIENT_ID=498456238517-i2ftoqjf5qakvvtpli1e17esf42f2evc.apps.googleusercontent.com

# Where Vite forwards /api in development. Include the context path if your Tomcat uses one.
VITE_BACKEND_URL=http://localhost:8080

# Optional, dev only: act as a seeded user without logging in (2 = team lead in database/seed.sql).
# Needs COMPASS_DEV_AUTH=true on the backend. Leave blank to use the normal sign-in.
VITE_DEV_USER_ID=
