# Team values for backend/.env.local. Committed to git, so it holds NO secrets:
# __DB_PASSWORD__ and __SMTP_PASSWORD__ are filled in from env-setup/secrets.env.
# Format for docker --env-file: KEY=value, no quotes, no spaces around "=".

# Supabase session pooler (IPv4). The direct db.<ref>.supabase.co host is IPv6-only and won't connect from most networks.
SUPABASE_DB_URL=jdbc:postgresql://aws-0-us-east-1.pooler.supabase.com:5432/postgres?user=postgres.xurfounmawoasophhxpg&password=__DB_PASSWORD__&sslmode=require

# Google Sign-In web client. Same value as VITE_GOOGLE_CLIENT_ID. Not a secret.
GOOGLE_CLIENT_ID=498456238517-i2ftoqjf5qakvvtpli1e17esf42f2evc.apps.googleusercontent.com

# Email through Resend.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USERNAME=resend
SMTP_PASSWORD=__SMTP_PASSWORD__
# TODO: change to an address on the Resend-verified domain; Resend rejects compass.local.
EMAIL_FROM=Compass <no-reply@compass.local>

# Base URL used in email and guest links.
PUBLIC_SITE_URL=https://compass201.vercel.app

# LOCAL ONLY: lets requests act as a user via the X-Dev-User-Id header. Never set this on Render.
COMPASS_DEV_AUTH=true

# Background email sender and scheduled jobs.
COMPASS_JOBS_ENABLED=true
