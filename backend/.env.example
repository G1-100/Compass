# Backend environment variables. Copy to backend/.env.local (git-ignored) and fill in.
#
# Tomcat does NOT read this file by itself. Use it as:
#   - Docker:  docker run --env-file backend/.env.local -p 8080:8080 compass-api
#   - Eclipse: copy each line into Servers > Tomcat > Open launch configuration > Environment
#   - Render:  add each one under the service's Environment tab (production values, and no COMPASS_DEV_AUTH)
# Format for --env-file: KEY=value, no quotes, no spaces around "=".
# Real values (DB password, SMTP key) come from the team password manager, never from git or chat.

# Required. Supabase > Connect > Session pooler > JDBC, password filled in, with &sslmode=require appended.
SUPABASE_DB_URL=jdbc:postgresql://aws-INDEX-REGION.pooler.supabase.com:5432/postgres?user=postgres.xurfounmawoasophhxpg&password=REPLACE_ME&sslmode=require

# Google Sign-In. Same value as VITE_GOOGLE_CLIENT_ID in frontend/.env.local. Not a secret. No client secret is used.
GOOGLE_CLIENT_ID=

# Email. Locally: Mailpit (localhost:1025, no username/password). Production: Resend (Raegen hands these over).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=Compass <no-reply@compass.local>

# Base URL used in email and guest links. Locally the Vite dev server; in production https://<vercel-domain>.
PUBLIC_SITE_URL=http://localhost:5173

# LOCAL ONLY: lets requests act as a user via the X-Dev-User-Id header. Never set this on Render.
COMPASS_DEV_AUTH=true

# Background email sender and scheduled jobs (default true).
COMPASS_JOBS_ENABLED=true
